<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app-wide background is paper. Native glass needs a transparent
         context for ComposeView and its internally created AndroidComposeView. -->
    <style name="ThemeOverlay.STU.Glass" parent="">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/brand_deep</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <style name="AppTheme.NativeBase" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:background">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme.NativeBase" />

    <!-- Default auto-system launch (Light Porcelain when system is in Light mode) -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_porcelain</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_truth_bell_light</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowBackground">@drawable/splash_light</item>
        <item name="android:statusBarColor">@color/splash_porcelain</item>
        <item name="android:navigationBarColor">@color/splash_porcelain</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Explicit Light launch theme (persisted by setSplashScreenTheme on API31+) -->
    <style name="AppTheme.NoActionBarLaunch.Light" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_porcelain</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_truth_bell_light</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowBackground">@drawable/splash_light</item>
        <item name="android:statusBarColor">@color/splash_porcelain</item>
        <item name="android:navigationBarColor">@color/splash_porcelain</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Explicit Dark launch theme (persisted by setSplashScreenTheme on API31+) -->
    <style name="AppTheme.NoActionBarLaunch.Dark" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_obsidian</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_truth_bell_dark</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowBackground">@drawable/splash_dark</item>
        <item name="android:statusBarColor">@color/splash_obsidian</item>
        <item name="android:navigationBarColor">@color/splash_obsidian</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
