<resources>
    <style name="AppTheme.LaunchBars.System" parent="AppTheme.NoActionBarLaunch">
        <item name="android:windowLightNavigationBar">@bool/launch_light_bars</item>
    </style>
    <style name="AppTheme.LaunchBars.Light" parent="AppTheme.NoActionBarLaunch">
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="AppTheme.LaunchBars.Dark" parent="AppTheme.NoActionBarLaunch">
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
