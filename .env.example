# 复制为 .env 后按需修改；真实密钥不要提交
STU_APP_HOME=/var/lib/stu-assistant
# 签名密钥：留空会拒绝启动（正式模式）；生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
STU_APP_JWT_SECRET=
# 演示模式：true 时用假数据、不连学校系统
STU_APP_DEMO=false
# 跨域来源（浏览器版同源不需要；打包 App 的 WebView 需要）
STU_APP_CORS_ORIGINS=https://localhost,capacitor://localhost
